# ==============================================================================
# Environment Configuration Template for Agrawal API (apps/api)
#
# References:
#   - docs/backend/architecture.md
#   - docs/backend/open-questions.md
#   - CONTEXT.md
#
# Rules:
#   - Never commit real credentials, API keys, or private keys to source control.
#   - Placeholders are explicit variables; do not invent fake company or grievance facts.
#   - In staging/production, secrets are populated from AWS SSM Parameter Store:
#     /agrawal/<staging|production>/<VARIABLE_NAME>
# ==============================================================================

# ------------------------------------------------------------------------------
# Runtime & Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
PORT=3000

# ------------------------------------------------------------------------------
# Database (PostgreSQL 18)
# ------------------------------------------------------------------------------
# App role: Restricted grants for running API application
DATABASE_URL="postgresql://agrawal_app:agrawal_app_dev_password@127.0.0.1:5432/agrawal_dev?schema=public"

# Migration / Owner role: Used solely by 'prisma migrate deploy'
DATABASE_MIGRATION_URL="postgresql://postgres:postgres_dev_password@127.0.0.1:5432/agrawal_dev?schema=public"

# ------------------------------------------------------------------------------
# CORS & CSRF
# ------------------------------------------------------------------------------
# Comma-separated list of exact web origins allowed for CORS and CSRF checks.
# In production, web and API must share registrable domain (e.g., https://register.<domain>)
# Note: The domain is an open operator decision (see docs/backend/open-questions.md).
WEB_ORIGINS="http://localhost:5173,http://localhost:3000"

# ------------------------------------------------------------------------------
# Session Durations (Sliding TTL in days)
# ------------------------------------------------------------------------------
SESSION_TTL_WEB_DAYS=30
SESSION_TTL_MOBILE_DAYS=90

# ------------------------------------------------------------------------------
# Authentication (Firebase Phone Auth)
# ------------------------------------------------------------------------------
# Firebase Project ID (from SSM Parameter Store)
FIREBASE_PROJECT_ID=
# Firebase Service Account JSON string or base64 (from SSM Parameter Store)
FIREBASE_SERVICE_ACCOUNT_JSON=


# ------------------------------------------------------------------------------
# SMS & OTP Authentication (MSG91 / Console)
# ------------------------------------------------------------------------------
# Provider: 'msg91' (required in production) or 'console' (local/testing default)
SMS_PROVIDER=console
# MSG91 Flow API credentials (required in production or when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Template variable name for the OTP code (default: otp)
MSG91_OTP_VAR=otp
# HMAC key for OTP verification hashes (base64 string of at least 32 bytes)
OTP_HMAC_KEY=
# ------------------------------------------------------------------------------
# Payments (Razorpay)
# ------------------------------------------------------------------------------
# Razorpay Key ID and Secret (test keys for local/staging, live keys for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Fees in paise (₹1 = 100 paise, ₹49 = 4900 paise per ADR-0016)
REGISTRATION_PAYMENT_PAISE=100
BUSINESS_LISTING_FEE_PAISE=4900
# REGISTRATION_PAYMENT_REQUIRED=true keeps captured payment mandatory.
# Set false only for the controlled unpaid pilot; unpaid submissions may proceed
# only from STARTED with paymentId=null. Existing captured payments remain valid.
REGISTRATION_PAYMENT_REQUIRED=true

# 32 random bytes, base64-encoded, used to HMAC-hash VPAs/card IDs for duplicate head checks
PAYMENT_IDENTITY_HMAC_KEY=

# ------------------------------------------------------------------------------
# Storage (AWS S3)
# ------------------------------------------------------------------------------
# S3 private bucket for uploads (media/photos)
S3_BUCKET=
AWS_REGION=ap-south-1
MEDIA_URL_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# Romanization (Google Cloud Translation API - Devanagari -> Latin)
# ------------------------------------------------------------------------------
# Google Cloud project ID and service account credentials JSON
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ------------------------------------------------------------------------------
# Content Moderation / Image Screening (Stage 2)
# ------------------------------------------------------------------------------
# Disabled in Stage 1; flipped to true in Stage 2 (M12)
IMAGE_SCREENING_ENABLED=false
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=

# Self-service erasure (right-to-be-forgotten) requests from members
ERASURE_SELF_SERVICE=false

# ------------------------------------------------------------------------------
# Event Pass Signing (Stage 2)
# ------------------------------------------------------------------------------
# JSON array of [{ "kid": string, "privateKeyPem": string }]. First entry signs; all verify.
EVENT_PASS_SIGNING_KEYS=

# ------------------------------------------------------------------------------
# Background Workers & Job Processing (pg-boss)
# ------------------------------------------------------------------------------
WORKERS_ENABLED=true

# ------------------------------------------------------------------------------
# Data Retention & Lifecycle Rules
# ------------------------------------------------------------------------------
# Statutory retention period in days for payment records after Erasure (ADR-0026 §5: eight years)
RETENTION_DAYS_PAYMENTS=2920
# Statutory retention period in days for consent records and processing logs (ADR-0005 Rule 8(3))
RETENTION_DAYS_CONSENT_AND_LOGS=365
# Hours before an uncompleted founding registration is marked abandoned
REGISTRATION_ABANDON_AFTER_HOURS=24
# Days before an unconfirmed join request expires
JOIN_REQUEST_EXPIRY_DAYS=14
# Maximum pending join requests per Family
JOIN_REQUESTS_PENDING_MAX_PER_FAMILY=10

# ------------------------------------------------------------------------------
# Noticeboards Tuning & Moderation (Stage 2)
# ------------------------------------------------------------------------------
# Distinct families threshold required to auto-hide a notice (invariant 13)
REPORTS_THRESHOLD=5
# Days an author is suspended from posting when a notice is hidden (invariant 14)
SUSPENSION_DURATION_DAYS=7
# Daily posting cap per member per IST calendar day
POSTING_CAP_PER_DAY=3
# Business listing validity period in days (180 days per ADR-0016)
BUSINESS_LISTING_DURATION_DAYS=180
# Archival request escalation to Officer if unconfirmed by family (in days)
ARCHIVAL_ESCALATION_DAYS=7
# Blocked words JSON array for automated text checks
BLOCKED_WORDS="[]"
# Regex for detecting personal Indian mobile numbers in notice text (invariant 16)
PHONE_REGEX_IN_TEXT="(?:\+91[\s-]?)?[6-9]\d{9}"

# ------------------------------------------------------------------------------
# Blood SOS Tuning (Stage 2)
# ------------------------------------------------------------------------------
# Delay in minutes between widening tiers (city -> district -> state)
SOS_TIER_INTERVAL_MINUTES=30
# Hours before an active Blood SOS request auto-expires
SOS_EXPIRY_HOURS=24
# Minimum compatible donors in city before Tier 1 falls back to all donors (ADR-0011)
SOS_DENSITY_FLOOR=5
# Days before a member who reported a donation is eligible as a donor again
DONOR_COOLDOWN_DAYS=90
# Maximum Blood SOS alerts one donor can receive per IST calendar day (ADR-0006 §4)
DONOR_DAILY_ALERT_CAP=3
