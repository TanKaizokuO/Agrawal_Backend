// Payments Prisma schema — owns Payment, Refund, HeadAnchor, WebhookEvent tables

enum PaymentPurpose {
  REGISTRATION
  BUSINESS_LISTING

  @@schema("public")
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED

  @@schema("public")
}

enum IdentityKind {
  VPA
  CARD
  NONE

  @@schema("public")
}

enum RefundReason {
  DUPLICATE_HEAD
  JOIN_DECLINED
  JOIN_EXPIRED
  REGISTRATION_CANCELLED
  REGISTRATION_ABANDONED
  PUBLICATION_FAILED
  OFFICER

  @@schema("public")
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  PROCESSED
  FAILED

  @@schema("public")
}

model Payment {
  id                String         @id
  purpose           PaymentPurpose
  subjectId         String         @map("subject_id")
  payerPhoneE164    String         @map("payer_phone_e164")
  payerMemberId     String?        @map("payer_member_id")
  amountPaise       Int            @map("amount_paise")
  currency          String         @default("INR")
  status            PaymentStatus  @default(CREATED)
  razorpayOrderId   String         @unique @map("razorpay_order_id")
  razorpayPaymentId String?        @unique @map("razorpay_payment_id")
  method            String?
  identityKind      IdentityKind?  @map("identity_kind")
  identityHash      String?        @map("identity_hash")
  identityMasked    String?        @map("identity_masked")
  capturedAt        DateTime?      @map("captured_at") @db.Timestamptz(6)
  failedAt          DateTime?      @map("failed_at") @db.Timestamptz(6)
  failureReason     String?        @map("failure_reason")
  consumedAt        DateTime?      @map("consumed_at") @db.Timestamptz(6)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  retainUntil       DateTime?      @map("retain_until") @db.Timestamptz(6)
  refunds           Refund[]

  @@index([subjectId], map: "payment_subject_id_idx")
  @@index([identityHash], map: "payment_identity_hash_idx")
  @@index([status, createdAt], map: "payment_status_created_at_idx")
  @@index([status, consumedAt], map: "payment_status_consumed_idx")
  @@map("payment")
  @@schema("public")
}

model Refund {
  id                  String          @id
  paymentId           String          @map("payment_id")
  payment             Payment         @relation(fields: [paymentId], references: [id])
  reason              RefundReason
  amountPaise         Int             @map("amount_paise")
  razorpayRefundId    String?         @unique @map("razorpay_refund_id")
  status              RefundStatus    @default(REQUESTED)
  requestedAt         DateTime        @default(now()) @map("requested_at") @db.Timestamptz(6)
  processedAt         DateTime?       @map("processed_at") @db.Timestamptz(6)
  processingStartedAt DateTime?       @map("processing_started_at") @db.Timestamptz(6)
  attemptNumber       Int             @default(0) @map("attempt_number")
  failureReason       String?         @map("failure_reason")
  attempts            RefundAttempt[]

  @@unique([paymentId], map: "refund_payment_id_unique")
  @@index([status, requestedAt], map: "refund_status_requested_at_idx")
  @@index([status, processingStartedAt], map: "refund_status_processing_started_idx")
  @@map("refund")
  @@schema("public")
}

/// One logical refund attempt; its provider ID is retained when later retries begin.
model RefundAttempt {
  refundId        String   @map("refund_id")
  refund          Refund   @relation(fields: [refundId], references: [id])
  attemptNumber   Int      @map("attempt_number")
  razorpayRefundId String? @unique @map("razorpay_refund_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([refundId, attemptNumber], map: "refund_attempt_pkey")
  @@map("refund_attempt")
  @@schema("public")
}

/// A leased order-creation reservation; its payment ID is the provider receipt for recovery.
model PaymentOrderClaim {
  purpose        PaymentPurpose @map("purpose")
  subjectId      String         @map("subject_id")
  paymentId      String         @unique(map: "payment_order_claim_payment_id_key") @map("payment_id")
  amountPaise    Int            @map("amount_paise")
  attemptedAt    DateTime       @default(now()) @map("attempted_at") @db.Timestamptz(6)

  @@id([purpose, subjectId], map: "payment_order_claim_pkey")
  @@index([attemptedAt], map: "payment_order_claim_attempted_at_idx")
  @@map("payment_order_claim")
  @@schema("public")
}

/// A durable payment event and its leased job-dispatch state.
model PaymentOutboxJob {
  id            String    @id
  eventKey      String    @unique @map("event_key")
  jobName       String    @map("job_name")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  claimedAt     DateTime? @map("claimed_at") @db.Timestamptz(6)
  dispatchedAt  DateTime? @map("dispatched_at") @db.Timestamptz(6)

  @@index([dispatchedAt, createdAt], map: "payment_outbox_pending_idx")
  @@map("payment_outbox_job")
  @@schema("public")
}

model HeadAnchor {
  identityHash String   @id @map("identity_hash")
  familyId     String   @unique @map("family_id")
  paymentId    String   @map("payment_id")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("head_anchor")
  @@schema("public")
}

model WebhookEvent {
  eventId     String    @id @map("event_id")
  event       String
  receivedAt  DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  payload     Json

  @@map("webhook_event")
  @@schema("public")
}
